{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    },

    "strict": true,
    "noEmit": false,
    "outDir": "./.tmp-tests",

    "skipLibCheck": true,
    "resolveJsonModule": true,

    "types": ["node", "vitest/globals"]
  },

  "include": [
    "tests/**/*.ts",
    "src/domain/nutrition/snapshot.ts"
  ]
}

